{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "link2linux",
  "identifier": "dev.link2linux.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "link2linux",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/firewalld/services/link2linux.xml": "../packaging/linux/firewalld/link2linux.xml",
          "/etc/ufw/applications.d/link2linux": "../packaging/linux/ufw/link2linux"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/firewalld/services/link2linux.xml": "../packaging/linux/firewalld/link2linux.xml",
          "/etc/ufw/applications.d/link2linux": "../packaging/linux/ufw/link2linux"
        }
      }
    },
    "category": "Utility",
    "shortDescription": "Connect your Android phone to your Linux desktop",
    "longDescription": "See your phone's notifications, messages and calls, browse photos, share files and the clipboard, and view the phone's screen from your desktop, over your local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
