{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may call. Nothing is granted by default: add each new command or plugin permission here explicitly.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-app-info",
    "allow-startup-error",
    "allow-restart-app",
    "allow-list-devices",
    "allow-unpair-device",
    "allow-get-pairing-state",
    "allow-start-pairing",
    "allow-pair-with",
    "allow-answer-code",
    "allow-cancel-pairing",
    "allow-list-notifications",
    "allow-dismiss-notification",
    "allow-run-notification-action",
    "allow-notification-image",
    "allow-get-clipboard-status",
    "allow-send-clipboard",
    "allow-list-transfers",
    "allow-pick-files-to-send",
    "allow-send-dropped-files",
    "allow-cancel-transfer",
    "allow-forget-transfer",
    "allow-open-received-file",
    "allow-show-received-file",
    "allow-get-phone-status",
    "allow-get-ring-status",
    "allow-ring-phone",
    "allow-stop-ringing",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-calls-status",
    "allow-start-bluetooth-pairing",
    "allow-cancel-bluetooth-pairing",
    "allow-confirm-bluetooth-code",
    "allow-choose-bluetooth-device",
    "allow-connect-calls",
    "allow-answer-call",
    "allow-decline-call",
    "allow-hang-up-call",
    "allow-dial-number",
    "allow-send-call-tones",
    "allow-set-call-muted",
    "allow-get-screen-status",
    "allow-start-screen",
    "allow-stop-screen",
    "allow-send-screen-input",
    "allow-request-screen-key-frame",
    "allow-list-photos",
    "allow-photo-thumbnail",
    "allow-save-photo",
    "allow-open-saved-photo",
    "allow-show-saved-photo",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
